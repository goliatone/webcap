#!/bin/bash

# Check for -debug flag
if [[ $* == *-debug* ]]; then
    set -x
fi

export LGR_NO_TIMESTAMP=true

PROJECT="webcap"
GIT_MAIN="main"
VERSION_FILE="./.version"

# If we have a .taskenv file load it as source
if [ -f .taskenv ]; then
    # shellcheck disable=SC1091
    source .taskenv
fi

# This makes all bin packages installed via npm available here
# e.g. bogota, nyc, autocannon, etc.
PATH=$(pwd)/node_modules/.bin:$PATH

# This will make local scripts available when present.
PATH=$(pwd)/bin:$PATH

GO_TOOLCHAIN="${GO_TOOLCHAIN:-local}"
GO_QUALITY_ROOT_DIR="${GO_QUALITY_ROOT_DIR:-$(pwd)}"
GO_GOLANGCI_LINT_VERSION="${GO_GOLANGCI_LINT_VERSION:-v2.11.3}"
GO_GOLANGCI_LINT_VERSION_FILE="${GO_GOLANGCI_LINT_VERSION_FILE:-.golangci-lint-version}"
GO_GOVULNCHECK_VERSION="${GO_GOVULNCHECK_VERSION:-v1.1.4}"
GO_GOSEC_VERSION="${GO_GOSEC_VERSION:-v2.25.0}"
GO_GOSEC_EXCLUDE="${GO_GOSEC_EXCLUDE:-G703}"
GO_GOSEC_EXCLUDE_RULES="${GO_GOSEC_EXCLUDE_RULES:-diff.go:G115,G304;service.go:G301,G306;manifest.go:G304;naming.go:G401,G505;playwright.go:G204;workflow.go:G304;workflow_report.go:G304}"
GO_QUALITY_BASELINE_DIR="${GO_QUALITY_BASELINE_DIR:-$(pwd)/tools/quality/baselines}"
GO_QUALITY_BASELINE_SCRIPT="${GO_QUALITY_BASELINE_SCRIPT:-$(pwd)/tools/quality/baseline.sh}"
GO_QUALITY_GOCACHE="${GO_QUALITY_GOCACHE:-$(pwd)/.tmp/go-cache}"
GO_QUALITY_GOTMPDIR="${GO_QUALITY_GOTMPDIR:-$(pwd)/.tmp/go-tmp}"
GO_QUALITY_WORKFILE="${GO_QUALITY_WORKFILE:-$(pwd)/.tmp/go.work}"
GO_QUALITY_MODULE_DIRS="${GO_QUALITY_MODULE_DIRS:-.}"
GO_QUALITY_INCLUDE_EXAMPLES="${GO_QUALITY_INCLUDE_EXAMPLES:-false}"
GO_LINT_NEW_FROM_REV="${GO_LINT_NEW_FROM_REV:-origin/${GIT_MAIN}}"

function _task:log {
    if command -v lgr >/dev/null 2>&1; then
        lgr "$@"
    else
        printf '%s\n' "$*"
    fi
}

#################################################
# Development dependencies
#################################################

function _install:lgr {
    mkdir -p bin
    if hash lgr 2>/dev/null; then
        _task:log OK "lgr already installed..."
    else
        echo "Installing lgr"
        brew tap goliatone/homebrew-tap
        brew install lgr
        _task:log OK "lgr installed..."
    fi
}

function _install:changelog {
    if command -v git-cliff >/dev/null 2>&1; then
        _task:log OK "git-cliff already installed..."
    else
        echo "Installing git-cliff"
        brew install orhun/git-cliff/git-cliff
        _task:log OK "git-cliff installed..."
    fi
}

function _install:brew {
    if [[ $(command -v brew) == "" ]]; then
        echo "Installing Homebrew"
        /usr/bin/ruby -e "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/master/install)"
    else
        _task:log I "Updating Homebrew"
        brew update
    fi
}

function _install:envset {
    if hash envset 2>/dev/null; then
        _task:log OK "envset installed..."
    else
        _task:log I "Installing envset..."
        brew install envset
        _task:log OK "envset installed..."
    fi
}

function _go:bin {
    if command -v go >/dev/null 2>&1; then
        command -v go
        return 0
    fi

    echo "go binary not found in PATH" >&2
    return 1
}

function _go:quality:prepare_env {
    export GOCACHE="${GOCACHE:-${GO_QUALITY_GOCACHE}}"
    export GOTMPDIR="${GOTMPDIR:-${GO_QUALITY_GOTMPDIR}}"
    mkdir -p "${GOCACHE}" "${GOTMPDIR}"
    _go:quality:prepare_work || return 1
}

function _go:quality:prepare_work {
    local go_bin
    local work_dir
    local work_name
    local dir
    local -a modules=()

    if [ -n "${GOWORK:-}" ]; then
        return 0
    fi

    go_bin=$(_go:bin) || return 1
    work_dir="$(dirname "${GO_QUALITY_WORKFILE}")"
    work_name="$(basename "${GO_QUALITY_WORKFILE}")"
    mkdir -p "${work_dir}"
    while IFS= read -r dir; do
        if [ "${dir}" = "." ]; then
            modules+=("${GO_QUALITY_ROOT_DIR}")
        else
            modules+=("${GO_QUALITY_ROOT_DIR}/${dir}")
        fi
    done < <(cd "${GO_QUALITY_ROOT_DIR}" && _go:module_dirs)

    if [ "${#modules[@]}" -le 1 ]; then
        export GOWORK=off
        return 0
    fi

    (cd "${work_dir}" && rm -f "${work_name}" && "${go_bin}" work init "${modules[@]}") || return 1

    export GOWORK="${GO_QUALITY_WORKFILE}"
}

function _go:golangci_lint_version {
    if [ -f "${GO_GOLANGCI_LINT_VERSION_FILE}" ]; then
        awk 'NF { print $1; exit }' "${GO_GOLANGCI_LINT_VERSION_FILE}"
        return 0
    fi

    printf '%s\n' "${GO_GOLANGCI_LINT_VERSION}"
}

function _go:tool_bin_dir {
    local go_bin
    local gobin
    local gopath

    go_bin=$(_go:bin) || return 1
    gobin="$("${go_bin}" env GOBIN)"
    if [ -n "${gobin}" ]; then
        printf '%s\n' "${gobin}"
        return 0
    fi

    gopath="$("${go_bin}" env GOPATH)"
    if [ -n "${gopath}" ]; then
        printf '%s\n' "${gopath%/}/bin"
        return 0
    fi

    echo "unable to resolve Go tool bin directory" >&2
    return 1
}

function _go:tool:path {
    local name=$1
    local bin_dir

    if command -v "${name}" >/dev/null 2>&1; then
        command -v "${name}"
        return 0
    fi

    bin_dir=$(_go:tool_bin_dir) || return 1
    if [ -x "${bin_dir}/${name}" ]; then
        printf '%s\n' "${bin_dir}/${name}"
        return 0
    fi

    return 1
}

function _go:tool:install {
    local name=$1
    local target=$2
    local go_bin

    go_bin=$(_go:bin) || return 1
    _go:quality:prepare_env || return 1
    echo "Installing ${name} (${target})"
    GOTOOLCHAIN="${GO_TOOLCHAIN}" "${go_bin}" install "${target}" || return 1
    _go:tool:path "${name}" || return 1
}

function _go:tool:ensure {
    local name=$1
    local target=$2
    local tool_path

    if tool_path=$(_go:tool:path "${name}" 2>/dev/null); then
        printf '%s\n' "${tool_path}"
        return 0
    fi

    _go:tool:install "${name}" "${target}"
}

function _go:module_dirs {
    local dir

    if [ "${GO_QUALITY_MODULE_DIRS}" != "auto" ]; then
        for dir in ${GO_QUALITY_MODULE_DIRS}; do
            if [ "${dir}" = "." ] || [ -f "${dir}/go.mod" ]; then
                printf '%s\n' "${dir}"
            fi
        done
        return 0
    fi

    printf '%s\n' "."
    find . -mindepth 2 -name go.mod \
        -not -path './.git/*' \
        -not -path './.tmp/*' \
        -not -path './vendor/*' \
        -print \
        | sed 's#/go\.mod$##' \
        | sed 's#^\./##' \
        | if [ "${GO_QUALITY_INCLUDE_EXAMPLES}" = "true" ]; then
            cat
        else
            grep -v '^examples$'
        fi \
        | sort
}

function _go:run_modules {
    local task=$1
    local dir

    shift
    if [ "$#" -gt 0 ]; then
        "${task}" "$@"
        return "$?"
    fi

    while IFS= read -r dir; do
        if [ -z "${dir}" ]; then
            continue
        fi
        echo "==> ${task} (${dir})"
        (cd "${dir}" && "${task}" ./...) || return 1
    done < <(_go:module_dirs)
}

function _go:packages {
    local go_bin
    local -a patterns=()

    go_bin=$(_go:bin) || return 1
    if [ "$#" -gt 0 ]; then
        patterns=("$@")
    else
        patterns=("./...")
    fi

    "${go_bin}" list "${patterns[@]}"
}

function _go:files {
    find . -type f -name '*.go' \
        -not -path './.git/*' \
        -not -path './.gocache/*' \
        -not -path './.tmp/*' \
        -not -path './node_modules/*' \
        | sort
}

function _go:lint:patterns {
    if [ "$#" -gt 0 ]; then
        printf '%s\n' "$@"
        return 0
    fi

    printf '%s\n' "./..."
}

