    while IFS= read -r pattern; do
        if [ -n "${pattern}" ]; then
            patterns+=("${pattern}")
        fi
    done < <(_go:lint:patterns "$@")
    if git rev-parse --verify --quiet "${GO_LINT_NEW_FROM_REV}^{commit}" >/dev/null; then
        diff_args=(--new-from-rev="${GO_LINT_NEW_FROM_REV}" --whole-files)
    else
        _task:log WARN "lint base ${GO_LINT_NEW_FROM_REV} not found; running full lint"
    fi
    "${golangci_lint_bin}" run "${diff_args[@]}" "${patterns[@]}"
}

